;align-items:center;justify-content:center;font-size:24px;letter-spacing:.1em;font-weight:700;writing-mode:vertical-rl;padding:18px 0}\n.stair.f .rib{background:#caa64a;color:#3a1f2b}\n.stair .body{padding:18px 20px;border-left:1px dashed #b8896b}\n.stair .body h4{margin:0 0 6px;font-size:20px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n.stair .body h4 .pill{background:#f4ecdf;color:#7a1d2c;font-size:11px;letter-spacing:.18em;padding:2px 8px;border:1px dashed #b8896b}\n.stair .body .price{color:#7a1d2c;font-size:22px;font-weight:700;margin:0 0 4px}\n.stair .body .annual{font-size:13px;color:#7a5048;margin:0 0 12px}\n.stair .body ul{margin:0;padding-left:18px;color:#5a3a45;font-size:14px}\n.stair .body ul li{margin:2px 0}\n.stair .meta{padding:18px 16px;background:#f4ecdf;border-left:1px dashed #b8896b;font-size:13px;color:#5a3a45;display:flex;flex-direction:column;justify-content:center;gap:6px}\n.stair .meta b{font-size:11px;letter-spacing:.18em;color:#7a1d2c;text-transform:uppercase;font-weight:600}\n.stair.f{box-shadow:inset 0 0 0 2px #caa64a}\n.compat{margin-top:18px;overflow-x:auto}\ntable.cmp{border-collapse:collapse;width:100%;font-size:14px;background:#fbf7f1}\ntable.cmp th,table.cmp td{border:1px dashed #b8896b;padding:12px 14px;text-align:left;vertical-align:top}\ntable.cmp th{background:#f4ecdf;color:#7a1d2c;font-weight:600;letter-spacing:.06em;font-size:12px;text-transform:uppercase}\ntable.cmp td small{display:block;color:#7a5048;font-size:12px;margin-top:3px}\n.tag-row{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 0}\n.tag-row span{font-size:11px;letter-spacing:.12em;text-transform:uppercase;background:#f4ecdf;border:1px dashed #b8896b;padding:2px 8px;color:#7a5048}\n.notes{margin:20px 0 0;padding:18px;background:#fbf7f1;border:1px dashed #b8896b;font-size:14px;color:#5a3a45}\n.notes b{color:#7a1d2c}\n.faq-topic{margin:18px 0 28px}\n.faq-topic h3{margin:0 0 6px;font-size:20px}\n.faq-topic>p.topic-lead{margin:0 0 12px;color:#5a3a45;font-size:14px}\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n@media(max-width:760px){.faq-grid{grid-template-columns:1fr}}\n.faq-item{background:#fbf7f1;border:1px dashed #b8896b;padding:0}\n.faq-item summary{cursor:pointer;padding:14px 18px;font-weight:600;color:#3a1f2b;list-style:none;display:flex;justify-content:space-between;gap:12px;align-items:flex-start}\n.faq-item summary::-webkit-details-marker{display:none}\n.faq-item summary::after{content:\"+\";color:#7a1d2c;font-weight:700;flex-shrink:0}\n.faq-item[open] summary::after{content:\"−\"}\n.faq-item .answer{padding:0 18px 16px;color:#5a3a45;font-size:14px}\nfooter{background:#3a1f2b;color:#fbf7f1;padding:36px 0;margin-top:40px;font-size:13px}\nfooter .row{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;align-items:center}\nfooter .crumbs a{color:#f4ecdf;border-bottom-color:rgba(244,236,223,.4)}\nfooter .stamp{border:1px dashed #f4ecdf;padding:6px 12px;letter-spacing:.18em;text-transform:uppercase;font-size:11px}\n</style><div class=\"brand-strip\"><b>甜甜圈</b><span>订阅计划 / 使用说明 / 常见问题</span></div>\n\n<header class=\"slab\" id=\"top\">\n<div class=\"wrap\">\n<h1>甜甜圈订阅计划与使用说明</h1>\n<p class=\"lede\">本页按清单方式整理甜甜圈当前在售的三档订阅、对应流量与设备数、客户端适配渠道，以及按主题分组的常见问题，方便对照选择。</p>\n<div class=\"kpi-grid\" role=\"group\" aria-label=\"核心参数一览\">\n<div class=\"tile a\">\n<span class=\"k\">档位数量</span>\n<div class=\"v\">3</div>\n<span class=\"u\">基础 / 旗舰 / 团队</span>\n<div class=\"bar\"><i></i></div>\n</div>\n<div class=\"tile b\">\n<span class=\"k\">起步月费</span>\n<div class=\"v\">¥15</div>\n<span class=\"u\">基础版 / 月付</span>\n<div class=\"bar\"><i></i></div>\n</div>\n<div class=\"tile c\">\n<span class=\"k\">单账号最高设备</span>\n<div class=\"v\">5 台</div>\n<span class=\"u\">旗舰版配置</span>\n<div class=\"bar\"><i></i></div>\n</div>\n<div class=\"tile d\">\n<span class=\"k\">单账号最高流量</span>\n<div class=\"v\">1000 GB</div>\n<span class=\"u\">团队版 / 月度</span>\n<div class=\"bar\"><i></i></div>\n</div>\n</div>\n</div>\n</header>\n\n<nav class=\"jump\" aria-label=\"区块跳转\">\n<div class=\"wrap\">\n<ol>\n<li><a href=\"#plans\">订阅计划</a></li>\n<li><a href=\"#setup\">使用说明</a></li>\n<li><a href=\"#compat\">客户端兼容</a></li>\n<li><a href=\"#faq\">常见问题</a></li>\n<li><a href=\"#foot\">联系与说明</a></li>\n</ol>\n</div>\n</nav>\n\n<main>\n<section class=\"block\" id=\"plans\">\n<div class=\"wrap\">\n<h2><span class=\"num\">01</span>订阅计划</h2>\n<p class=\"lead\">以下价格与权益为当前在售档位。甜甜圈不提供无理由试用，所有数据均按自然月计算，未用完不结转。</p>\n\n<div class=\"coupon-row\">\n<div class=\"coupon\"><span class=\"tag\">首单</span><h4>新用户首次月付</h4><p>首次开通任意档位，按所选档位月费一次性结算，自开通起 30 天内有效。</p></div>\n<div class=\"coupon\"><span class=\"tag\">年付</span><h4>按年付费档位</h4><p>基础版、旗舰版、团队版均提供按年付费选项，价格见下方阶梯；年付订单不与月付订单合并计算有效期。</p></div>\n<div class=\"coupon\"><span class=\"tag\">续费</span><h4>到期续费规则</h4><p>到期前 3 天可通过账户后台手动续费；过期未续的账号，节点配置将在到期后 72 小时内回收。</p></div>\n</div>\n\n<div class=\"stairs\">\n<article class=\"stair\">\n<div class=\"rib\">T1</div>\n<div class=\"body\">\n<h4>基础版 <span class=\"pill\">入门槛</span></h4>\n<div class=\"price\">¥15<span> /月</span></div>\n<p class=\"annual\">按年付仅需 ¥150/年</p>\n<ul>\n<li>每月 100GB 极速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n</div>\n<div class=\"meta\">\n<b>适用场景</b>\n<span>个人轻度使用、单设备浏览与日常音视频</span>\n<b>设备上限</b>\n<span>3 台</span>\n<b>流量上限</b>\n<span>100 GB / 月</span>\n</div>\n</article>\n\n<article class=\"stair f\">\n<div class=\"rib\">T2</div>\n<div class=\"body\">\n<h4>旗舰版 <span class=\"pill\">推荐</span></h4>\n<div class=\"price\">¥35<span> /月</span></div>\n<p class=\"annual\">按年付仅需 ¥350/年</p>\n<ul>\n<li>每月 300GB 极速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7x24 优先工单支持</li>\n</ul>\n</div>\n<div class=\"meta\">\n<b>适用场景</b>\n<span>多设备同时在线、家庭共享与游戏场景</span>\n<b>设备上限</b>\n<span>5 台</span>\n<b>流量上限</b>\n<span>300 GB / 月</span>\n</div>\n</article>\n\n<article class=\"stair\">\n<div class=\"rib\">T3</div>\n<div class=\"body\">\n<h4>团队版 <span class=\"pill\">高配额</span></h4>\n<div class=\"price\">¥85<span> /月</span></div>\n<p class=\"annual\">按年付仅需 ¥850/年</p>\n<ul>\n<li>每月 1000GB 极速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n</div>\n<div class=\"meta\">\n<b>适用场景</b>\n<span>工作室、小型团队、跨境协作与企业多分支</span>\n<b>设备上限</b>\n<span>20 台</span>\n<b>流量上限</b>\n<span>1000 GB / 月</span>\n</div>\n</article>\n</div>\n\n<div class=\"notes\"><b>关于流量与节点：</b>流量按自然月重置，结余不结转；普通线路节点池与 VIP 专属高带宽节点为两个独立通道，不同档位可使用范围以页面披露为准。</div>\n</div>\n</section>\n\n<section class=\"block\" id=\"setup\">\n<div class=\"wrap\">\n<h2><span class=\"num\">02</span>使用说明</h2>\n<p class=\"lead\">甜甜圈提供订阅链接与客户端两步流程。订阅链接用于在第三方客户端中添加服务，客户端负责连接节点。</p>\n<ol class=\"steps\">\n<li><strong>获取订阅链接</strong><span>登录甜甜圈账户后台，在「订阅」栏目复制以 <code>http</code> 或 <code>https</code> 开头的完整链接；链接包含一次性 token，请勿公开发布。</span></li>\n<li><strong>选择对应客户端</strong><span>在下方「客户端兼容」表格中挑选与设备系统匹配的客户端，前往其官方页面或应用市场下载。</span></li>\n<li><strong>导入订阅</strong><span>在客户端「订阅 / 配置文件」位置粘贴链接，或扫码后台提供的二维码完成导入。</span></li>\n<li><strong>选择节点连接</strong><span>客户端自动更新节点列表后，手动选择目标区域的节点，再点击连接；连接成功会在系统状态栏显示图标。</span></li>\n<li><strong>用量与设备管理</strong><span>在后台「用量」可查看本月已用流量与结余；在「设备」中可移除不在线的设备，腾出设备名额。</span></li>\n<li><strong>续费与到期</strong><span>到期前 3 天后台会提示续费；到期后节点配置将进入 72 小时保留期，期间续费可恢复。</span></li>\n</ol>\n\n<div class=\"notes\"><b>使用提示：</b>同一账号同时在线的设备数量需低于或等于所选档位的设备上限；当超出时，新设备会被拒绝加入。</div>\n</div>\n</section>\n\n<section class=\"block\" id=\"compat\">\n<div class=\"wrap\">\n<h2><span class=\"num\">03</span>客户端兼容</h2>\n<p class=\"lead\">下方表格列出常见客户端与系统组合。甜甜圈以订阅链接形式对外提供，请通过对应客户端的官方渠道获取下载。</p>\n<div class=\"compat\">\n<table class=\"cmp\">\n<thead>\n<tr><th>客户端</th><th>支持系统</th><th>导入方式</th><th>节点格式</th></tr>\n</thead>\n<tbody>\n<tr>\n<td>通用协议 A 类客户端\n<div class=\"tag-row\"><span>跨平台</span></div>\n</td>\n<td>Windows / macOS / Linux / iOS / Android<br><small>桌面端以图形界面为主，移动端需配合应用列表中支持导入链接的应用</small></td>\n<td>粘贴订阅链接 / 扫描二维码</td>\n<td>SS / SSR / VMess / VLESS<br><small>具体支持协议以客户端版本为准</small></td>\n</tr>\n<tr>\n<td>命令行客户端\n<div class=\"tag-row\"><span>开发者</span></div>\n</td>\n<td>Linux / macOS / 路由器固件<br><small>适用于自建网关或软路由环境</small></td>\n<td>使用命令行工具导入链接或手动填入服务器地址</td>\n<td>与所选客户端保持一致</td>\n</tr>\n<tr>\n<td>代理工具类客户端\n<div class=\"tag-row\"><span>图形界面</span></div>\n</td>\n<td>Windows / macOS / Android<br><small>iOS 系统需选择支持导入外部链接的图形界面应用</small></td>\n<td>通过「订阅设置 → 添加」粘贴链接</td>\n<td>按客户端默认协议解析</td>\n</tr>\n</tbody>\n</table>\n</div>\n<div class=\"notes\"><b>关于下载：</b>本表格只说明兼容关系，不提供具体应用商店或下载地址。请在所选客户端的官方网站或对应系统应用市场中下载安装，避免使用来源不明的修改版。</div>\n</div>\n</section>\n\n<section class=\"block\" id=\"faq\">\n<div class=\"wrap\">\n<h2><span class=\"num\">04</span>常见问题</h2>\n<p class=\"lead\">FAQ 按主题分组：账户与计费、设备与用量、流媒体与节点、客户端与协议、隐私与安全。每个问题均可展开查看答案。</p>\n\n<div class=\"faq-topic\">\n<h3>账户与计费</h3>\n<p class=\"topic-lead\">关于开通、续费、退款与订单变更的常见疑问。</p>\n<div class=\"faq-grid\">\n<details class=\"faq-item\">\n<summary>支持哪些支付方式？</summary>\n<div class=\"answer\">甜甜圈后台提供常见的线上支付渠道，具体渠道以结账页面实际展示为准；选择不同渠道时，到账时间可能从即时到几分钟不等。</div>\n</details>\n<details class=\"faq-item\">\n<summary>订阅开通后多久生效？</summary>\n<div class=\"answer\">付款到账后，订阅状态会自动切换为「已开通」，订阅链接与节点配置立即可见，无需人工激活。</div>\n</details>\n<details class=\"faq-item\">\n<summary>年付订单可以中途升级或降级吗？</summary>\n<div class=\"answer\">可以。在后台「订单」中将年付订单切换为按月结算，再按所需档位重新下单；原年付剩余有效期可按页面提示折算后抵扣，不足部分需补差。</div>\n</details>\n<details class=\"faq-item\">\n<summary>是否提供退款？</summary>\n<div class=\"answer\">本服务以虚拟资源开通为主，已开通的订阅暂不支持无理由退款。具体规则以后台「退款与售后」页面文字说明为准。</div>\n</details>\n<details class=\"faq-item\">\n<summary>为什么账单显示金额与下单时不一致？</summary>\n<div class=\"answer\">多数情况是切换了货币或支付渠道手续费不同。建议以「订单详情」中带币种符号的金额为准，并保留截图以便核对。</div>\n</details>\n<details class=\"faq-item\">\n<summary>发票如何申请？</summary>\n<div class=\"answer\">如需发票，请通过后台工单或本页底部的联系方式提交开票信息，申请周期与具体形式以后台说明为准。</div>\n</details>\n</div>\n</div>\n\n<div class=\"faq-topic\">\n<h3>设备与用量</h3>\n<p class=\"topic-lead\">关于同时在线数量、流量计算方式以及超额后的处理。</p>\n<div class=\"faq-grid\">\n<details class=\"faq-item\">\n<summary>「台设备」是如何计算的？</summary>\n<div class=\"answer\">以同一订阅链接登录的客户端实例数为单位；同一台物理设备上切换客户端通常只算一台。被踢出后可手动从后台移除，腾出名额。</div>\n</details>\n<details class=\"faq-item\">\n<summary>流量是按什么单位计算的？</summary>\n<div class=\"answer\">采用 1 GB = 1024 MB 的进位方式统计上传与下载总和；后台用量面板通常以 GiB 与 GB 两种单位显示。</div>\n</details>\n<details class=\"faq-item\">\n<summary>超出流量后会怎样？</summary>\n<div class=\"answer\">超出当月额度后，连接会被暂停到下个自然月重置，或可自行购买流量加油包恢复。暂停期间订阅有效期内仍可登录后台续费、调整档位。</div>\n</details>\n<details class=\"faq-item\">\n<summary>为什么后台显示已用流量比客户端多？</summary>\n<div class=\"answer\">这是正常现象。后台统计依据为节点入出口流量，包含少量协议开销；客户端本地仪表显示的是估算值，二者通常有百分之几的差异。</div>\n</details>\n</div>\n</div>\n\n<div class=\"faq-topic\">\n<h3>流媒体与节点</h3>\n<p class=\"topic-lead\">关于节点选择、流媒体区域以及专线能力。</p>\n<div class=\"faq-grid\">\n<details class=\"faq-item\">\n<summary>不同档位能用什么节点？</summary>\n<div class=\"answer\">基础版使用普通线路节点池；旗舰版在普通线路基础上加入 IPLC 专线节点与游戏加速优化；团队版额外提供 VIP 专属高带宽节点池与企业定制路由支持。</div>\n</details>\n<details class=\"faq-item\">\n<summary>流媒体解锁如何识别？</summary>\n<div class=\"answer\">客户端连上节点后，访问对应流媒体平台若解析为本地原创片单，通常说明该节点支持原生解锁；建议在同一区域内切换 1–2 个节点对比。</div>\n</details>\n<details class=\"faq-item\">\n<summary>节点延迟突然升高怎么办？</summary>\n<div class=\"answer\">先在同一区域切换到其他节点尝试；若多节点同时升高，多为本地网络或晚高峰拥塞，建议错峰或联系工单反馈。</div>\n</details>\n</div>\n</div>\n\n<div class=\"faq-topic\">\n<h3>客户端与协议</h3>\n<p class=\"topic-lead\">关于订阅链接导入、协议兼容性以及多端同步。</p>\n<div class=\"faq-grid\">\n<details class=\"faq-item\">\n<summary>可以同时在手机和电脑上登录吗？</summary>\n<div class=\"answer\">可以，在设备上限范围内任意组合；超出时会提示最早上线的一台设备被顶下线。</div>\n</details>\n<details class=\"faq-item\">\n<summary>订阅链接更换后，原客户端怎么处理？</summary>\n<div class=\"answer\">请在客户端「更新订阅」或「刷新配置」中手动同步一次；个别客户端需要先复制新链接并重新粘贴才能生效。</div>\n</details>\n<details class=\"faq-item\">\n<summary>支持哪些协议？</summary>\n<div class=\"answer\">主流协议包括 SS、SSR、VMess、VLESS 等；具体协议以所选客户端版本支持的范围为准。</div>\n</details>\n</div>\n</div>\n\n<div class=\"faq-topic\">\n<h3>隐私与安全</h3>\n<p class=\"topic-lead\">关于账号安全、日志范围以及订阅链接保护。</p>\n<div class=\"faq-grid\">\n<details class=\"faq-item\">\n<summary>订阅链接可以公开分享吗？</summary>\n<div class=\"answer\">不建议。链接中包含一次性 token，泄露后他人可登录您的账号并消耗流量；如怀疑泄露，请在后台重置订阅链接使旧链接失效。</div>\n</details>\n<details class=\"faq-item\">\n<summary>后台会保存访问日志吗？</summary>\n<div class=\"answer\">账号侧后台仅保留登录与订单相关记录，用于安全审计与售后查询；具体保留期限以后台公示条款为准。</div>\n</details>\n<details class=\"faq-item\">\n<summary>双重验证是否开启？</summary>\n<div class=\"answer\">建议在「账户安全」中为后台登录开启双重验证，可显著降低密码泄露带来的风险。</div>\n</details>\n</div>\n</div>\n\n</div>\n</section>\n</main>\n\n<footer id=\"foot\">\n<div class=\"wrap\">\n<div class=\"row\">\n<div class=\"crumbs\">\n<a href=\"#top\">回到顶部</a> · <a href=\"#plans\">订阅计划</a> · <a href=\"#faq\">常见问题</a>\n</div>\n<div class=\"stamp\">甜甜圈 · 订阅说明</div>\n</div>\n<div>本页价格、流量与设备数为参考结构示例，请以甜甜圈后台最终公示信息为准。</div>\n</div>\n</footer>",
